# .env.example
# Copy this file to .env and fill in your actual API keys and settings.

# LangChain / LangSmith Tracing (Optional)
LANGCHAIN_API_KEY="your_langchain_api_key_here" # For LangSmith
LANGCHAIN_TRACING_V2="true" # Set to "true" to enable LangSmith tracing. "false" to disable.
LANGCHAIN_PROJECT="OpenCanvas FastAPI" # Your project name in LangSmith

# LLM API Keys
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Web Search / Document Fetching API Keys
EXA_API_KEY="your_exa_api_key_here" # For Exa web search
FIRECRAWL_API_KEY="your_firecrawl_api_key_here" # For Firecrawl document scraping (URL inclusion)

# Agent Configuration
LANGGRAPH_SQLITE_PATH="opencanvas_checkpoints.sqlite" # Default path for the agent state database

# Supabase (Optional - if backend needs direct Supabase access)
# NEXT_PUBLIC_SUPABASE_URL="your_supabase_url_here"
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
